# ====================================================================
# BOOK JOURNAL - ENVIRONMENT VARIABLES CONFIGURATION
# ====================================================================
# Gunakan berkas ini sebagai acuan saat melakukan penyetelan variabel lingkungan
# di server cloud (seperti Railway, Render, Fly.io, Heroku) atau salin berkas ini
# menjadi `.env` di server lokal Anda.

# URL Utama Aplikasi (Opsional, tinggalkan kosong untuk auto-deteksi)
# Contoh: http://localhost:8080 atau https://book-tracker.up.railway.app
APP_URL=

# Konfigurasi Koneksi Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=book_tracker_db
DB_USER=root
DB_PASS=
